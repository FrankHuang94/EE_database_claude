Vgkb0 gk_00 0 DC 0.75
* ---- gf: 3 x 3 nodes, 20 mOhm per edge, 1 A per node, bumps at [(0, 0), (0, 2), (2, 0), (2, 2)]
Rgfh00 gf_00 gf_01 0.02
Rgfv00 gf_00 gf_10 0.02
Rgfh01 gf_01 gf_02 0.02
Rgfv01 gf_01 gf_11 0.02
Rgfv02 gf_02 gf_12 0.02
Rgfh10 gf_10 gf_11 0.02
Rgfv10 gf_10 gf_20 0.02
Rgfh11 gf_11 gf_12 0.02
Rgfv11 gf_11 gf_21 0.02
Rgfv12 gf_12 gf_22 0.02
Rgfh20 gf_20 gf_21 0.02
Rgfh21 gf_21 gf_22 0.02
Igf00 gf_00 0 DC 1
Igf01 gf_01 0 DC 1
Igf02 gf_02 0 DC 1
Igf10 gf_10 0 DC 1
Igf11 gf_11 0 DC 1
Igf12 gf_12 0 DC 1
Igf20 gf_20 0 DC 1
Igf21 gf_21 0 DC 1
Igf22 gf_22 0 DC 1
Vgfb0 gf_00 0 DC 0.75
Vgfb1 gf_02 0 DC 0.75
Vgfb2 gf_20 0 DC 0.75
Vgfb3 gf_22 0 DC 0.75

.control
op
let ex5vmin = v(g5_22)
let ex5drop = 0.8 - v(g5_22)
* current delivered by the bumps into the grid, excluding the corner nodes' own 0.5 A loads
let ex5ibump = -(i(Vg5b0) + i(Vg5b1) + i(Vg5b2) + i(Vg5b3)) - 4*0.5
let p10a = 0.75 - v(gc_00)
let p10b = 0.75 - v(gk_22)
let p10c = 0.75 - v(gf_11)
echo "ex5vmin = $&ex5vmin"
echo "ex5drop = $&ex5drop"
echo "ex5ibump = $&ex5ibump"
echo "p10a = $&p10a"
echo "p10b = $&p10b"
echo "p10c = $&p10c"
.endc
.end
