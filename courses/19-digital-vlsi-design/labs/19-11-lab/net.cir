Cw40 n40 0 2.1546875e-15
CL n40 0 2.302f
Be e 0 V=1-V(n40)
.tran 0.5p 15n
.meas tran elmore INTEG V(e) FROM=0 TO=15n
.meas tran t50 TRIG V(in) VAL=0.5 RISE=1 TARG V(n40) VAL=0.5 RISE=1
.end
