.control
op
let vo1 = v(o1)
let vo2 = v(o2)
let vo3 = v(o3)
let vo4 = v(o4)
let vo5 = v(o5)
let vo6 = v(o6)
let vo7 = v(o7)
let vo8 = v(o8)
let vo9 = v(o9)
let vo10 = v(o10)
print vo1 vo2 vo3 vo4 vo5 vo6 vo7 vo8 vo9 vo10
ac dec 200 100 10Meg
let t1 = -v(o1)/v(f1)
let tdb1 = db(t1)
let tph1 = 180/pi*cph(t1)
meas ac fc1 when tdb1=0
meas ac phc1 find tph1 at=fc1
meas ac fx1 when tph1=-180 cross=last
meas ac gx1 find tdb1 at=fx1
let pm1 = 180 + phc1
let gm1 = -gx1
print pm1 gm1
let t2 = -v(o2)/v(f2)
