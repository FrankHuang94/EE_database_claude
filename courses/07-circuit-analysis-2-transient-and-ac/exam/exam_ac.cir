* EXPECT q6m   key:solutions.md#X07.6m rtol=5e-4
* EXPECT q6n   key:solutions.md#X07.6n rtol=2e-4
* EXPECT q6o   key:solutions.md#X07.6o rtol=1e-4
* EXPECT q9d   key:solutions.md#X07.9d rtol=1e-4
* EXPECT q9e   key:solutions.md#X07.9e rtol=2e-4
* EXPECT q9f   key:solutions.md#X07.9f rtol=2e-4
* EXPECT q9g   key:solutions.md#X07.9g rtol=2e-4
* EXPECT q9h   key:solutions.md#X07.9h rtol=2e-4
* EXPECT q9k   key:solutions.md#X07.9k rtol=5e-4
* EXPECT q10b  key:solutions.md#X07.10b scale=1e-3 rtol=1e-4
* EXPECT q10d  key:solutions.md#X07.10d rtol=2e-4
* EXPECT q10f  key:solutions.md#X07.10f rtol=5e-4
* EXPECT q10g  key:solutions.md#X07.10g rtol=5e-4
* EXPECT q11i  key:solutions.md#X07.11i rtol=2e-4
* EXPECT q11j  key:solutions.md#X07.11j rtol=2e-4
* EXPECT q11k  key:solutions.md#X07.11k rtol=5e-4
* EXPECT q11l  key:solutions.md#X07.11l rtol=2e-4
* EXPECT q11m  key:solutions.md#X07.11m rtol=2e-4
* EXPECT q12b  key:solutions.md#X07.12b rtol=5e-4
* EXPECT q12f  key:solutions.md#X07.12f rtol=2e-4
